DEEPSEEK_API_KEY=your_deepseek_api_key_here
ADMIN_PASSWORD=changeme123
PORT=3000

# --- Supabase backup mirror (optional but recommended) ---
# Survey-specific names on purpose: a bare SUPABASE_URL is already set in some
# of this org's environments and points at a DIFFERENT project. Using it here
# would mirror survey responses into the wrong database.
# Run supabase/schema.sql in the target project first.
SURVEY_SUPABASE_URL=https://<your-project-ref>.supabase.co
SURVEY_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Bump when questions are added, removed or reworded (default 1).
SURVEY_SCHEMA_VERSION=1
