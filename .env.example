DEEPSEEK_API_KEY=your_deepseek_api_key_here
ADMIN_PASSWORD=changeme123
PORT=3000

# --- Supabase backup mirror (optional but recommended) ---
# Vercel's Supabase integration sets SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# for you; those are picked up automatically and nothing below is needed.
# Run supabase/schema.sql in that project first - the mirror refuses to write to
# a database that has no `responses` table.
#
# Set these two only to override the integration's values (e.g. a project linked
# to more than one database):
# SURVEY_SUPABASE_URL=https://<your-project-ref>.supabase.co
# SURVEY_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
#
# Optional hard pin: refuse any project whose ref is not this one.
# SURVEY_SUPABASE_PROJECT_REF=<your-project-ref>

# Bump when questions are added, removed or reworded (default 1).
SURVEY_SCHEMA_VERSION=1
